---
import type { ThemeNotFoundProps } from '@/lib/theme-props';
import SuibiShell from './SuibiShell.astro';
type Props = ThemeNotFoundProps;
const { options, urls, pages, sidebarData, currentPath, pluginCtx, errorTitle } = Astro.props;
---
<SuibiShell title={errorTitle} options={options} urls={urls} pages={pages} sidebarData={sidebarData} currentPath={currentPath} pluginCtx={pluginCtx}>
  <section class="suibi-not-found"><h1>{errorTitle}</h1><p>这页内容可能已被移动，或者从未写下。</p><form method="get" action={`${urls.siteUrl}/`} role="search"><label for="suibi-search">搜索站内内容</label><div><input id="suibi-search" name="s" type="search" placeholder="输入关键词" /><button type="submit">搜索</button></div></form><a href={`${urls.siteUrl}/`}>返回首页 →</a></section>
</SuibiShell>
