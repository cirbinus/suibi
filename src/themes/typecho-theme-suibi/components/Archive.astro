---
import type { ThemeArchiveProps } from '@/lib/theme-props';
import SuibiShell from './SuibiShell.astro';
import SuibiStreamItem from './SuibiStreamItem.astro';
import SuibiStreamPagination from './SuibiStreamPagination.astro';
import { suibiSettings } from './suibi';

type Props = ThemeArchiveProps;
const { options, urls, pages, sidebarData, currentPath, pluginCtx, archiveTitle, posts, pagination } = Astro.props;
const settings = suibiSettings(options);
---

<SuibiShell
  title={archiveTitle} options={options} urls={urls} pages={pages} sidebarData={sidebarData}
  currentPath={currentPath} pluginCtx={pluginCtx} section="archive"
>
  <header class="suibi-stream-heading"><h1>{archiveTitle}</h1></header>
  <div class="suibi-stream" data-suibi-stream>
    {posts.length ? posts.map(post => (
      <SuibiStreamItem
        post={post} settings={settings}
        dateFormat={options.postDateFormat} timezone={options.timezone}
      />
    )) : <section class="suibi-empty"><h2>没有找到内容</h2><p>换个分类或关键词再看看。</p></section>}
  </div>
  <SuibiStreamPagination
    hasPrev={pagination.hasPrev} hasNext={pagination.hasNext}
    prevUrl={pagination.prevUrl} nextUrl={pagination.nextUrl}
    mode={settings.continuousLoadMode} label="归档分页"
  />
</SuibiShell>
