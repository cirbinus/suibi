---
import type { ThemeIndexProps } from '@/lib/theme-props';
import SuibiShell from './SuibiShell.astro';
import SuibiStreamPagination from './SuibiStreamPagination.astro';
import { formatSuibiDate, plainExcerpt, suibiSettings } from './suibi';

type Props = ThemeIndexProps;
const { options, urls, pages, sidebarData, currentPath, pluginCtx, posts, pagination } = Astro.props;
const settings = suibiSettings(options);
---
<SuibiShell
  options={options} urls={urls} pages={pages} sidebarData={sidebarData}
  currentPath={currentPath} pluginCtx={pluginCtx} section="home" liveRefresh
>
  <header class="suibi-stream-heading">
    <h1>随笔</h1>
    <p>一些持续写下的观察与思考</p>
  </header>
  <div class="suibi-stream" data-suibi-stream>
    {posts.length ? posts.map(post => (
      <article class="suibi-stream-item" data-suibi-cid={post.cid}>
        <div class="suibi-item-meta">
          <time datetime={new Date(post.created * 1000).toISOString()}>{formatSuibiDate(post.created, options.postDateFormat, options.timezone)}</time>
          {post.categories[0] && <><span aria-hidden="true">·</span><a href={post.categories[0].permalink}>{post.categories[0].name}</a></>}
        </div>
        <h2><a href={post.permalink}>{post.title}</a></h2>
        {post.excerpt && <p>{plainExcerpt(post.excerpt)}</p>}
      </article>
    )) : <section class="suibi-empty"><h2>这里还很安静</h2><p>第一篇随笔正在路上。</p></section>}
  </div>
  <SuibiStreamPagination
    hasPrev={pagination.hasPrev} hasNext={pagination.hasNext}
    prevUrl={pagination.prevUrl} nextUrl={pagination.nextUrl}
    mode={settings.continuousLoadMode} label="随笔分页"
  />
</SuibiShell>
