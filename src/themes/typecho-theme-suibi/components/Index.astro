---
import type { ThemeIndexProps } from '@/lib/theme-props';
import SuibiShell from './SuibiShell.astro';
import SuibiStreamItem from './SuibiStreamItem.astro';
import SuibiStreamPagination from './SuibiStreamPagination.astro';
import { suibiSettings } from './suibi';

type Props = ThemeIndexProps;
const { options, urls, pages, sidebarData, currentPath, pluginCtx, posts, pagination } = Astro.props;
const settings = suibiSettings(options);
---

<SuibiShell
  options={options} urls={urls} pages={pages} sidebarData={sidebarData}
  currentPath={currentPath} pluginCtx={pluginCtx} section="home" liveRefresh
>
  <h1 class="suibi-sr-only">{options.title}</h1>
  <div class="suibi-stream" data-suibi-stream>
    {posts.length ? posts.map(post => (
      <SuibiStreamItem
        post={post} settings={settings}
        dateFormat={options.postDateFormat} timezone={options.timezone}
      />
    )) : <section class="suibi-empty"><h2>这里还很安静</h2><p>第一篇内容正在路上。</p></section>}
  </div>
  <SuibiStreamPagination
    hasPrev={pagination.hasPrev} hasNext={pagination.hasNext}
    prevUrl={pagination.prevUrl} nextUrl={pagination.nextUrl}
    mode={settings.continuousLoadMode} label="内容分页"
  />
</SuibiShell>
