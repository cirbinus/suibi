---
import type { ThemePageProps } from '@/lib/theme-props';
import { optimizeContentImages } from '@/lib/image-transform';
import SuibiShell from './SuibiShell.astro';
import SuibiComments from './SuibiComments.astro';
import { formatSuibiDate, plainExcerpt, suibiSettings } from './suibi';

type Props = ThemePageProps;
const { options, urls, pages, sidebarData, currentPath, pluginCtx, page, commentPagination } = Astro.props;
const settings = suibiSettings(options);
---
<SuibiShell title={page.title} description={plainExcerpt(page.content, 160)} options={options} urls={urls} pages={pages} sidebarData={sidebarData} currentPath={currentPath} pageContext={{ hasComments: page.allowComment, pageType: 'page' }} pluginCtx={pluginCtx} section={page.slug.toLowerCase() === 'about' || page.title === '关于' ? 'about' : 'none'} detail>
  <article class="suibi-article suibi-page" itemscope itemtype="https://schema.org/Article">
    <header class="suibi-article__header"><div class="suibi-item-meta"><span>页面</span><span aria-hidden="true">·</span><time>{formatSuibiDate(page.created, options.postDateFormat, options.timezone)}</time></div><h1 itemprop="headline">{page.title}</h1></header>
    <div class="suibi-prose" view-image itemprop="articleBody" set:html={optimizeContentImages(page.content, settings.imageOptimizeParams, urls.siteUrl)} />
  </article>
  {(page.allowComment || commentPagination.totalComments > 0) && <SuibiComments cid={page.cid} componentLoadMode={settings.commentComponentLoadMode} initialLoadMode={settings.commentInitialLoadMode} cooldownSeconds={options.commentsPostIntervalEnable ? (options.commentsPostInterval || 60) : 0} />}
</SuibiShell>
