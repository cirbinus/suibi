FROM node:22-bookworm-slim AS build

RUN npm install --global bun@1.4.2
WORKDIR /app
COPY . .
RUN cp deploy/wrangler.preview.toml wrangler.toml \
 && bun install --frozen-lockfile --force --linker hoisted \
 && bun run build \
 && bun run patch:deploy-wrangler

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
EXPOSE 8787
CMD ["./node_modules/.bin/wrangler", "dev", "--config", "dist/server/wrangler.json", "--ip", "0.0.0.0", "--port", "8787", "--local", "--persist-to", "/data", "--log-level", "warn"]
